<div class="towns-container">
  <h1><i class="fa-solid fa-flag"></i><%= @town.name %>のルート一覧</h1>

  <ul class="index">
    <% @routes.each do |route| %>
      <%= link_to town_route_path(@town, route), class: "btn-main" do %>
        <%= route.name %>
      <% end %>
    <% end %>
  </ul>

  <div class="towns-container-bottom">
    <%= link_to "新しいルートを登録する", new_town_route_path(@town), class: "btn-add" %>
    <%= link_to "この町の情報を編集する", edit_town_path(@town), class: "btn-edit" %>
  </div>

</div>

<div class="towns-bottom">
  <button type="button"
          onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
          class="btn-back">
    戻る
  </button>
</div>
<div class="towns-container">

  <h1><i class="fa-solid fa-pen"></i></i> 町を登録する</h1>

  <%= form_with model: @town, class: "towns-form" do |f| %>

    <div class="form-group">
      <%= f.label :name, "町名" %>
      <%= f.text_field :name %>
    </div>

    <div class="form-group">
      <%= f.label :kana, "ふりがな" %>
      <%= f.text_field :kana %>
    </div>

    <div class="form-group">
      <%= f.label :description, "備考欄" %>
      <%= f.text_area :description %>
    </div>

    <div class="towns-submit">
      <%= f.submit "登録する", class:"btn-add" %>
    </div>

  <% end %>
</div>

<button type="button"
        onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
        class="btn-back">
  戻る
</button>

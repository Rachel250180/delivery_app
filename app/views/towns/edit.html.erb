<div class="towns-container">
  <h1><i class="fa-solid fa-pen"></i> 町の情報を編集</h1>


  <%= render "shared/error_messages", model: @town %>

  <%= form_with model: @town do |f| %>

    <div class="form-group">
      <%= f.label :kana, "ふりがな" %>
      <%= f.text_field :kana %>
    </div>

    <div class="form-group">
        <%= f.label :name, "町名" %>
        <%= f.text_field :name %>
    </div>

    <div class="form-group">
        <%= f.label :description, "備考欄" %>
        <%= f.text_field :description %>
    </div>

    <div class="towns-submit">
      <%= f.submit "更新する", class:"btn-add" %>
    </div>

  <% end %>

</div>

<div class="towns-bottom">
  <button type="button"
          onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
          class="btn-back">
    戻る
  </button>

  <%= button_to "この町を削除する", @town, method: :delete, class:"btn-danger" %>
</div>

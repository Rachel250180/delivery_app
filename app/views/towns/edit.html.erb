<div class="towns-container">
  <h1><i class="fa-solid fa-pen"></i> 町の情報を編集</h1>


  <%= form_with model: @town do |f| %>

    <div class="form-group">
        <%= f.label :name, "町名" %>
        <%= f.text_field :name %>
    </div>

    <div class="form-group">
        <%= f.label :description, "備考欄" %>
        <%= f.text_field :description %>
    </div>

    <div class="towns-submit">
      <%= f.submit "更新する", class:"btn-add" %>
    </div>

  <% end %>

</div>

<%= link_to "戻る", towns_path, class:"btn-back" %>

<%= button_to "この町を削除する", @town, method: :delete, class:"btn-danger" %>
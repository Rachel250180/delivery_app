<div class="towns-container">

  <h1 class="towns-title">
    お問い合わせ
  </h1>

  <% if @contact.errors.any? %>
    <div style="color: red;">
      <ul>
        <% @contact.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @contact, url: contacts_path, class: "towns-form" do |f| %>

    <div class="form-group">
      <%= f.text_field :name, placeholder: "名前", class: "towns-input" %>
    </div>

    <div class="form-group">
      <%= f.email_field :email, placeholder: "メールアドレス", class: "towns-input" %>
    </div>

    <div class="form-group">
      <%= f.text_area :message, placeholder: "内容", class: "towns-textarea" %>
    </div>

    <div class="towns-submit">
      <%= f.submit "送信する", class: "btn-add" %>
    </div>

  <% end %>

</div>

<button type="button"
        onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
        class="btn-back">
  戻る
</button>

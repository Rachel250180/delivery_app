<div class="towns-container">

  <h1 class="towns-title">
    お問い合わせ
  </h1>

  <%= form_with url: contacts_path, method: :post, class: "towns-form" do %>


    <div class="form-group">
      <%= text_field_tag :name, nil, placeholder: "名前", class: "towns-input" %>
    </div>

    <div class="form-group">
      <%= email_field_tag :email, nil, placeholder: "メールアドレス", class: "towns-input" %>
    </div>

    <div class="form-group">
      <%= text_area_tag :message, nil, placeholder: "内容", class: "towns-textarea" %>
    </div>

    <div class="towns-submit">
      <%= submit_tag "送信する", class: "btn-add" %>
    </div>

  <% end %>

</div>


<button type="button"
        onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
        class="btn-back">
  戻る
</button>


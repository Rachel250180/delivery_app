<h1>お問い合わせ</h1>

<%= form_with url: contacts_path, method: :post do %>
  <div>
    <%= text_field_tag :name, nil, placeholder: "名前" %>
  </div>

  <div>
    <%= email_field_tag :email, nil, placeholder: "メールアドレス" %>
  </div>

  <div>
    <%= text_area_tag :message, nil, placeholder: "内容" %>
  </div>

  <%= submit_tag "送信" %>
<% end %>
<% provide(:title, t(".title")) %>
<h1><%= t(".title") %></h1>

<div>
  <%= render "shared/error_messages", model: @password_reset %>

  <div>
    <%= form_with(model: @password_reset,
                  url: password_resets_path,
                  scope: :password_reset) do |f| %>
      <%= f.label :email %>
      <%= f.email_field :email %>

      <%= f.submit t(".submit") %>
    <% end %>
  </div>
</div>

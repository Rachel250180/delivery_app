<div class="route-show-map">
  <div id="map"></div>
</div>

<div class="route-info-card-btn">
  <button onclick="goToGoogleMap()" class="btn-simple">
    GoogleMapで確認する
  </button>
  <%= link_to "編集する", edit_town_route_path(@town, @route), class:"btn-edit" %>
</div>

<div class="route-info-card">
  <p>制作者：<%= @route.user&.name || "不明" %></p>
  <p>コメント：<%= linked_comment(@route.description) %></p>
  <p>＊実際のルート表示と異なる場合がございます。黄色いボタンよりGoogleMapでご確認ください。</p>
</div>

<%= link_to "戻る", town_path(@town), class: "btn-back" %>

<% content_for :sidebar do %>
  <%= render "route_info", editable: false %>
<% end %>


<!-- javascript関連 -->

<div id="route-data"
  data-points='<%= raw(
    @route.route_points.map { |p|
      {
        lat: p.latitude,
        lng: p.longitude,
        address: p.address
      }
    }.to_json
  ) %>'>
</div>

<script>
  sessionStorage.removeItem("route_points");
</script>

<div class="route-show-map">
  <div id="map"></div>
</div>

<div class="route-info-card">
  <button onclick="goToGoogleMap()", class="btn-simple">
    GoogleMapで確認する
  </button>
  <%= link_to "編集する", edit_town_route_path(@town, @route), class:"btn-edit" %>
</div>

<div class="route-info-card">
  <p>制作者：<%= @route.user&.name || "不明" %></p>
  <p>コメント：<%= @route.description %></p>
</div>

<% content_for :sidebar_pc do %>
  <%= render "route_info" %>
<% end %>

<% content_for :sidebar_mobile do %>
  <%= render "route_info" %>
<% end %>



<!-- javascript関連 -->

<div id="route-data"
     data-points="<%= @route.route_points.map { |p|
       { lat: p.latitude, lng: p.longitude }
     }.to_json %>">
</div>

<script>
  window.routePoints = <%= raw @points.to_json %>;
</script>

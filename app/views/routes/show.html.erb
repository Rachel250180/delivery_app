<div class="route-show-map">
  <div id="map"></div>
</div>





















<p><%= @route.description %></p>

<%= google_maps_link(@points) %>





<%= link_to "編集", edit_town_route_path(@town, @route) %>

<% content_for :sidebar_pc do %>
  <%= render "route_info" %>
<% end %>

<% content_for :sidebar_mobile do %>
  <%= render "route_info" %>
<% end %>










<!-- javascript読み込み -->
<%= javascript_include_tag "map_route" %>

<script>
  window.routePoints = <%= raw @points.to_json %>;

  window.initMap = function () {
    initMapShow(window.routePoints);
  };
</script>

<script
  src="https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.google_maps_api_key %>&callback=initMap"
  defer>
</script>
<h1>ルート編集</h1>

<div class="route-edit-map">
  <div id="map"></div>
</div>

<div class="route-info-card">
  <div class="bottom-submit">
    <%= button_tag "更新",
        type: "submit",
        form: "route-form" %>
  </div>

  <%= button_to "削除", [@town, @route],
        method: :delete,
        data: { confirm: "このルートを削除しますか？" } %>
</div>

<%= form_with model: [@town, @route], id: "route-form" do |f| %>

  <div>
    <%= f.label :name, "ルート名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description, "説明" %><br>
    <%= f.text_area :description %>
  </div>

  <input type="hidden" id="points_json" name="points_json">

<% end %>

<% content_for :sidebar_pc do %>
  <%= render "route_info" %>
<% end %>

<% content_for :sidebar_mobile do %>
  <%= render "route_info" %>
<% end %>








    <h3>経由地点</h3>
  <div id="points"></div>
  <ul id="points-list"></ul>


<%= link_to "戻る", town_path(@town) %>



<!-- javascript関連 -->

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>

  window.routePoints = <%= raw @points.to_json %>;

  window.initMap = function () {
    initMapEdit(window.routePoints);
  };
</script>

<script
src="https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.google_maps_api_key %>&callback=initMap"
defer>
</script>
<%= render "shared/error_messages", model: @route %>
<div class="route-title">
  <h5>ルート編集画面</h5>
</div>

<div class="route-edit-map">
  <div id="map"></div>
</div>

<div class="route-info-card-btn">
  <div class="btn-submit">
    <%= button_tag "更新する",
        type: "submit",
        form: "route-form",
        class: "btn-add" %>

    <%= button_to "削除する", [@town, @route],
          method: :delete,
          data: { confirm: "このルートを削除しますか？" } ,
          class: "btn-danger"%>
  </div>
</div>

<div class="route-info-card">

  <%= form_with model: [@town, @route], id: "route-form" do |f| %>

    <div class="form-group">
      <%= f.label :name, "ルート名" %>
      <%= f.text_field :name %>
    </div>

    <div class="form-group">
      <%= f.label :description, "備考欄" %><br>
      <%= f.text_area :description %>
    </div>

    <input type="hidden" id="points_json" name="points_json">

  <% end %>
</div>

<% content_for :sidebar do %>
  <%= render "route_info",
    editable: true %>
<% end %>

<div class="route-info-card">
  <%= link_to "一覧へ戻る", town_path(@town), class:"btn-back" %>
</div>


<!-- javascript関連 -->

<div id="route-data"
  data-points='<%= raw(
    @route.route_points.map { |p|
      {
        lat: p.latitude,
        lng: p.longitude,
        address: p.address
      }
    }.to_json
  ) %>'>
</div>

<h1>ルート編集</h1>

<div class="route-edit-map">
  <div id="map"></div>
</div>

<div class="route-info-card">
  <div class="bottom-submit">
    <%= button_tag "更新",
        type: "submit",
        form: "route-form" %>
  </div>

  <%= button_to "削除", [@town, @route],
        method: :delete,
        data: { confirm: "このルートを削除しますか？" } %>
</div>


<%= form_with model: [@town, @route], id: "route-form" do |f| %>

  <div>
    <%= f.label :name, "ルート名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description, "説明" %><br>
    <%= f.text_area :description %>
  </div>

  <input type="hidden" id="points_json" name="points_json">

<% end %>


<% content_for :sidebar do %>
  <%= render "route_info",
    editable: true %>
<% end %>






<%= link_to "戻る", town_path(@town) %>



<!-- javascript関連 -->

<div id="route-data"
  data-points='<%= raw(
    @route.route_points.map { |p|
      {
        lat: p.latitude,
        lng: p.longitude,
        address: p.address
      }
    }.to_json
  ) %>'>
</div>

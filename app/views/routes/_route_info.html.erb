<% if @route.persisted? %>
  <div class="route-info-card">
    <h4>ルート詳細</h4>

    <p>ルート名</p>
    <h5><%= @route.name %></h5>

    <p>ルート作成日</p>
    <h5><%= @route.created_at.strftime("%Y/%m/%d") %></h5>
  </div>
<% end %>

<div class="route-info-card">
  <h4>配達経由地点（経由順）</h4>

  <div
    id="points-list"
    data-editable="<%= action_name != 'show' %>"
  >

    <% @route_points.each_with_index do |routepoint, i| %>

      <div class="delivery-item">

        <div class="delivery-item__left">

          <div class="delivery-item__number">
            <%= i + 1 %>
          </div>

          <p class="delivery-item__address">
            <%= routepoint.address %>
          </p>

        </div>

        <button
          type="button"
          class="delivery-item__delete-btn"
        >
        </button>

      </div>

    <% end %>

  </div>
</div>

<template id="delivery-item-template">

  <div class="delivery-item">

    <div class="delivery-item__left">

      <div class="delivery-item__number"></div>

      <p class="delivery-item__address"></p>

    </div>

    <button
      type="button"
      class="delivery-item__delete-btn"
    >
    </button>

  </div>

</template>
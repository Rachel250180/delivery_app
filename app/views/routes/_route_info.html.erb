<div class="route-info-card">
  <%= link_to "一覧へ戻る", town_path(@town), class:"btn-back" %>
</div>

<div class="route-info-card">
  <h4>ルート詳細</h4>
  <p>ルート名</p>
  <h5><%= @route.name %></h5>

  <p>ルート作成日</p>
  <h5><%= @route.created_at.strftime("%Y/%m/%d") %></h5>
</div>

<div class="route-info-card">
  <h4>配達経由地点（経由順）</h4>
  
  <% @points.each_with_index do |point, i| %>

    <div class="delivery-item">

      <div class="delivery-left">

        <div class="delivery-number">
          <%= i + 1 %>
        </div>

        <p class="delivery-address">
          <%= point.address %>
        </p>

      </div>

    </div>

  <% end %>
</div>  



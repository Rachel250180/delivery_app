<% content_for :map_scripts do %>
  <%= render "shared/google_maps_script" %>
<% end %>

<% content_for :sortable_scripts do %>
  <script
    src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"
    integrity="sha384-eeLEhtwdMwD3X9y+8P3Cn7Idl/M+w8H4uZqkgD/2eJVkWIN1yKzEj6XegJ9dL3q0"
    crossorigin="anonymous"
    defer
    data-sortable-script>
  </script>
<% end %>

<div class="route-title">
  <h5><%= @town.name %>のルート登録画面</h5>
</div>

<%= render "shared/error_messages", model: @route %>

<div class="route-new-map">
  <div id="map"></div>
</div>

<div class="route-info-card-btn">
  <div class="btn-submit">
    <%= button_tag "登録する",
        type: "submit",
        form: "route-form",
        class: "btn-add" %>
  </div>
</div>

<div class="route-info-card">
  <%= form_with model: [@town, @route],
              id: "route-form",
              data: { turbo: false } do |f| %>

    <div class="form-group">
      <%= f.label :name, "ルート名" %><br>
      <%= f.text_field :name %>
    </div>

    <div class="form-group">
      <%= f.label :estimated_duration, "所要時間（分）" %><br>
      <%= f.number_field :estimated_duration,
            min: 0,
            placeholder: "例: 90" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "備考欄" %><br>
      <%= f.text_area :description %>
    </div>

    <input type="hidden" id="points_json" name="points_json">
    
  <% end %>
</div>

<% content_for :sidebar do %>
  <%= render "route_info",
    editable: true %>
<% end %>


<button type="button"
        onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
        class="btn-back">
  戻る
</button>


<!-- javascript関連 -->

<div id="route-data"
  data-map-mode="new"
  data-max-points="<%= Route::MAX_ROUTE_POINTS %>"
  data-points='<%= raw(
    @route.route_points.map { |p|
      {
        lat: p.latitude,
        lng: p.longitude,
        address: p.address
      }
    }.to_json
  ) %>'>
</div>

<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Delivery App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta name="description" content="ルート表示アプリです。 お店から配達する地域までの最短ルートを自分で登録、検索することができます。">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

  <%= favicon_link_tag 'favicon.ico' %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

    <%# 共通レイアウト内のアイコンに必要なため、Font Awesome は全画面で読み込む %>
    <script
      src="https://kit.fontawesome.com/a8a441addb.js"
      crossorigin="anonymous"
      defer
      data-font-awesome-script>
    </script>

    <%= yield :map_scripts %>
    <%= yield :sortable_scripts %>

  </head>

  <body class="<%= controller_name %>-<%= action_name %>">
    <header>
      <%= render "layouts/header" %>
    </header>

    <div class="wrapper">
      
      <aside class="sidebar" id="sidebar">

        <%= render "layouts/sidebar" %>

        <%= yield :sidebar %>

      </aside>


      <main class="main">
        <div class="container-fluid">

          <% flash.each do |type, message| %>
            <div class="alert alert-<%= type %>">
              <%= message %>
            </div>
          <% end %>

          <%= yield %>

        </div>
      </main>
    </div>

    <footer class="footer">
      <%= render "layouts/footer" %>
    </footer>
  </body>
</html>

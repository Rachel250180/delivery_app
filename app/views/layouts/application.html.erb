<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Delivery App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta name="description" content="ルート表示アプリです。 お店から配達する地域までの最短ルートを自分で登録、検索することができます。">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

  <%= favicon_link_tag 'favicon.ico' %>

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
    <script src="https://kit.fontawesome.com/a8a441addb.js" crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >

    <!-- Google Maps -->
    <% unless content_for?(:google_maps_loaded) %>
      <% content_for :google_maps_loaded, true %>

      <script
        src="https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.google_maps_api_key %>&loading=async"
        async
        defer>
      </script>
    <% end %>

    <!-- Sortable -->
    <script
      src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"
      defer>
    </script>

  </head>

  <body class="<%= controller_name %>-<%= action_name %>">
    <header>
      <%= render "layouts/header" %>
    </header>

    <div class="wrapper">
      
      <aside class="sidebar" id="sidebar">

        <%= render "layouts/sidebar" %>

        <%= yield :sidebar %>

      </aside>


      <main class="main">
        <div class="container-fluid">

          <% flash.each do |type, message| %>
            <div class="alert alert-<%= type %>">
              <%= message %>
            </div>
          <% end %>

          <%= yield %>

        </div>
      </main>
    </div>

    <footer class="footer">
      <%= render "layouts/footer" %>
    </footer>
  </body>
</html>

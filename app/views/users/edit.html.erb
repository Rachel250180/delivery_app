<div class="users-container">
  <h1><i class="fa-solid fa-pencil"></i> マイページ</h1>

  <%= render "shared/error_messages", model: @user %>

  <%= form_with model: @user do |f| %>

    <div class="form-group">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name %>
    </div>

    <div class="form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email %>
    </div>

    <div class="users-container-sub">
      <%= f.submit "更新する", class:"btn-add" %>
    </div>

  <% end %>

</div>

<div class="users-bottom">
  <button type="button"
          onclick="window.history.length > 1 ? history.back() : location.href='<%= root_path %>'"
          class="btn-back">
    戻る
  </button>
</div>

<div class="users-container">
  <h1><i class="fa-solid fa-user-gear"></i> ユーザー登録</h1>


  <%= render "shared/error_messages", model: @user %>

  <%= form_with model: @user do |f| %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :email %>
    <%= f.email_field :email %>
  </div>

  <div class="form-group">
    <%= f.label :password %>

    <div class="password-wrapper">
      <%= f.password_field :password %>

      <i id="toggle-password"
        class="fa-solid fa-eye password-toggle"></i>
    </div>

    <small class="password-help">
      パスワードは8文字以上で入力してください
    </small>

    <div id="password-error" class="password-error"></div>
  </div>

  <div class="form-group">
  <%= f.label :password_confirmation %>

  <div class="password-wrapper">
      <%= f.password_field :password_confirmation %>

      <i id="toggle-password-confirmation"
        class="fa-solid fa-eye password-toggle"></i>
    </div>
  </div>

  <div class="users-container-sub">
    <%= f.submit "登録する", class:"btn-add" %>
  </div>

  <% end %>
</div>

<div class="users-bottom">
  <%= link_to "戻る", root_path, class:"btn-back" %>
</div>

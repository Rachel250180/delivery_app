<% content_for :title, "Home" %>
<div>
  <section class="hero">
    <h1>配達ルートアプリ <i class="fa-solid fa-truck" style="color: rgb(250, 204, 21);"></i> Catch-up</h1>
    <p>配達ルートを登録・確認できます。</p>

    <div class="search-town">
      <h2><i class="fa-solid fa-magnifying-glass"></i> 町を検索する</h2>

      <%= form_with url: towns_path, method: :get, local: true, class: "search-form" do |f| %>
        <%= f.text_field :name, placeholder: "町名を入力してください" %>
        <%= f.submit "検索", class: "search-btn" %>
      <% end %>
    </div>

    <div class="search-town">
      <h2><i class="fa-solid fa-location-dot"></i> 住所からルートを検索する</h2>

      <%= form_with url: route_search_path, method: :get, local: true, class: "search-form" do |f| %>
        <%= f.text_field :address, placeholder: "住所を入力してください" %>
        <%= f.submit "検索", class: "search-btn" %>
      <% end %>
    </div>
  </section>

  <section class="menu-grid">

    <%= link_to towns_path, class: "menu-card" do %>
      <i class="fa-regular fa-file-lines icon"></i>
      <h3>町一覧</h3>
      <p>登録されている町の一覧をチェック</p>
    <% end %>



    <% if current_user&.admin? %>
      <%= link_to new_town_path, class: "menu-card" do %>
        <i class="fa-solid fa-plus icon"></i>
        <h3>町登録</h3>
        <p>新しい町を追加、登録する</p>
      <% end %>
    <% end %>

    <% if logged_in? %>
      <%= link_to user_path(current_user), class: "menu-card" do %>
        <i class="fa-solid fa-user-gear icon"></i>
        <h3>マイページ</h3>
        <p>ユーザー情報を確認する</p>
      <% end %>
    <% end %>
  </section>
</div>

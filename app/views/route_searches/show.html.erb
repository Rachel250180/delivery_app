<% content_for :title, "住所検索結果" %>
<% content_for :map_scripts do %>
  <%= render "shared/google_maps_script" %>
<% end %>

<div class="route-show-map">
  <div id="map"></div>
</div>

<div class="route-info-card-btn">
  <button onclick="goToGoogleMap()" class="btn-simple">
    GoogleMapで確認する
  </button>
  <% if current_user&.id == @route.user_id %>
    <%= link_to "編集する", edit_town_route_path(@town, @route), class: "btn-edit" %>
  <% end %>

  <% if current_user&.admin? %>
    <%= button_to "代表ルートを解除",
                  town_route_representative_path(@town, @route),
                  method: :delete,
                  class: "btn-danger" %>
  <% end %>
</div>

<div class="route-info-card">
  <h4><i class="fa-solid fa-location-dot"></i> 住所検索結果</h4>

  <div class="route-info-item">
    <span>検索住所</span>
    <strong><%= @address %></strong>
  </div>

  <div class="route-info-item">
    <span>所要時間</span>
    <strong id="route-duration">計算中...</strong>
  </div>

  <div class="route-info-item">
    <span>距離</span>
    <strong id="route-distance">計算中...</strong>
  </div>
</div>

<div class="route-info-card">
  <% if @route.representative? %>
    <p class="route-representative-label">代表ルート</p>
  <% end %>
  <p>制作者：<%= @route.user&.name || "不明" %></p>
  <p>コメント：<%= linked_comment(@route.description) %></p>
  <p>＊実際のルート表示と異なる場合がございます。黄色いボタンよりGoogleMapでご確認ください。</p>
</div>

<%= link_to "戻る", root_path, class: "btn-back" %>

<% content_for :sidebar do %>
  <%= render "routes/route_info",
             editable: false,
             show_route_details: false %>
<% end %>

<div id="route-data"
  data-map-mode="show"
  data-max-points="<%= Route::MAX_ROUTE_POINTS %>"
  data-points="<%= @search_route_points.to_json %>">
</div>

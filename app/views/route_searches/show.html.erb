<% content_for :title, "住所検索結果" %>
<% content_for :map_scripts do %>
  <%= render "shared/google_maps_script" %>
<% end %>

<div class="route-show-map">
  <div id="map"></div>
</div>

<div>
  <section class="towns-container">
    <h1><i class="fa-solid fa-location-dot"></i> 住所検索結果</h1>

    <dl>
      <dt>検索住所：</dt>
      <dd><%= @address %></dd>

      <dt>対象地域：</dt>
      <dd><%= @town.name %></dd>

      <dt>使用する代表ルート：</dt>
      <dd><%= @route.name %></dd>

      <dt>Geocodingされた緯度：</dt>
      <dd><%= @latitude %></dd>

      <dt>Geocodingされた経度：</dt>
      <dd><%= @longitude %></dd>
    </dl>
  </section>

  <%= link_to "戻る", root_path, class: "btn-back" %>
</div>

<div id="route-data"
  data-map-mode="show"
  data-max-points="<%= Route::MAX_ROUTE_POINTS %>"
  data-points="<%= @search_route_points.to_json %>">
</div>
